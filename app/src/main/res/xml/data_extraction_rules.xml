<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12（API 31）及以上的数据抽取规则（dataExtractionRules）。
    显式声明哪些数据允许进入「云备份 / 设备间迁移」，
    核心业务数据库与同步状态一律排除，避免隐私数据被静默上传。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="lemon_preferences.xml" />
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="lemon_preferences.xml" />
        <exclude domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
